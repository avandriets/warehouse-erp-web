{
  "name": "warehouse-erp-ui",
  "version": "0.0.0",
  "scripts": {
    "nx": "nx",
    "start": "nx serve warehouse-erp-ui",
    "start:admin": "nx serve warehouse-admin-ui",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "graph": "nx graph",
    "watch": "nx build warehouse-erp-ui --watch --configuration development",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix --skip-nx-cache",
    "format": "npm run lint:fix && npm run format:prettier && npm run format:html",
    "format:prettier": "prettier --write .",
    "format:html": "html-beautify --replace \"apps/**/*.html\" \"libs/**/*.html\"",
    "format:check": "prettier --check . && node scripts/check-html-format.mjs",
    "typecheck": "nx run-many -t typecheck",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/forms": "21.2.24",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.24",
    "@angular/router": "21.2.24",
    "@auth0/auth0-angular": "^2.12.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "21.2.24",
    "@angular-devkit/schematics": "21.2.24",
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.24",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@schematics/angular": "21.2.24",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^21.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "js-beautify": "^1.15.4",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "~21.2.0",
    "nx": "23.2.1",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "verdaccio": "^6.3.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "smol-toml": "^1.9.0"
  },
  "nx": {
    "includedScripts": []
  }
}
