{
  "name": "shared",
  "projectType": "library",
  "sourceRoot": "libs/shared/src",
  "tags": ["type:util", "scope:shared"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"libs/shared/**/*.ts\" \"libs/shared/**/*.html\" --no-error-on-unmatched-pattern"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc -p libs/shared/tsconfig.json --noEmit"],
        "parallel": false
      }
    }
  }
}
