{
  "name": "profile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/profile/src",
  "prefix": "erp",
  "tags": ["scope:shared", "type:feature"],
  "projectType": "library",
  "// targets": "to see all targets run: nx show project profile --web",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint \"libs/profile/**/*.ts\" \"libs/profile/**/*.html\" --no-error-on-unmatched-pattern"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "ngc -p libs/profile/tsconfig.lib.json --noEmit",
          "tsc -p libs/profile/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "tsConfig": "libs/profile/tsconfig.spec.json",
        "watch": false,
        "buildTarget": "warehouse-erp-ui:build:development"
      }
    }
  }
}
