{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "feature/users/src/**/*.ts",
    "feature/roles/src/**/*.ts",
    "data-access/src/**/*.ts",
    "ui/src/**/*.ts",
    "util/src/**/*.ts"
  ],
  "exclude": ["**/*.spec.ts", "**/*.test.ts"]
}
